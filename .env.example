# SatisfactoryModLoader Build Secrets
# Copy this file to .env and fill in real values from the Epic Developer Portal.
# Never commit .env or real secrets to Git.

# Epic Online Services (EOS) Client Secret
EOS_CLIENT_SECRET=your_eos_client_secret_here

# Android File Server token (used for Android packaging / dedicated server builds)
ANDROID_FILE_SERVER_TOKEN=your_android_file_server_token_here
